  "terminology": [
    [
      "图页",
      "导出图形的整体页面，具有物理宽高。"
    ],
    [
      "图层",
      "图页内承载坐标轴、曲线及相关对象的区域。"
    ],
    [
      "曲线",
      "一个绘图系列；在柱图、箱线图等图型中也使用界面的这一名称。"
    ],
    [
      "批量选 Y",
      "从一张表选择多个 Y，生成同图多条曲线。"
    ],
    [
      "数据表批绘",
      "对多张数据表复用当前图形或模板，生成独立结果。"
    ],
    [
      "逐图层导出",
      "将当前图页的选中图层分别输出。"
    ],
    [
      "项目文件",
      "保存图形、数据与绑定的 .plotfig.json 文件。"
    ],
    [
      "模板",
      "用于复用结构或样式的配置，区别于完整工作区项目。"
    ]
  ],
